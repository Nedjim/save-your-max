{
  "name": "save-your-max",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint . && tsc --noEmit",
    "prepare": "husky",
    "test": "jest",
    "test:api": "pnpm --dir api exec prisma generate --schema prisma/schema.prisma && pnpm --dir api exec jest --runInBand",
    "test:front": "jest --config ./jest.config.js --runInBand --watch=false",
    "test:all": "pnpm run test:api && pnpm run test:front"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.99.1",
    "@tanstack/react-query": "^5.90.21",
    "@types/react-native": "^0.73.0",
    "babel-plugin-react-compiler": "19.0.0-beta-ebf51a3-20250411",
    "babel-preset-expo": "~58.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dayjs": "^1.11.19",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "i18next": "^26.0.8",
    "react": "19.3.0",
    "react-compiler-runtime": "19.0.0-beta-ebf51a3-20250411",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^17.0.6",
    "react-native": "0.88.1",
